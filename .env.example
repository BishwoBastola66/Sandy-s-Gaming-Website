# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional Email Provider (SpaceMail SMTP or Resend/SendGrid/Postmark)
EMAIL_PROVIDER=spacemail
EMAIL_FROM_ADDRESS=no-reply@sandygamings.com
EMAIL_FROM_NAME="Sandy's Gaming"
SPACEMAIL_HOST=mail.spacemail.com
SPACEMAIL_PORT=465
SPACEMAIL_USER=your_mailbox_user@sandygamings.com
SPACEMAIL_PASSWORD=your_spacemail_password_here

# Authentication Channels ('email' | 'sms' | 'both')
NEXT_PUBLIC_AUTH_OTP_CHANNEL=email

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Arcjet Bot & Attack Shield (https://app.arcjet.com)
ARCJET_KEY=ajkey_your_arcjet_key_here
